
// Teste de ponta a ponta da rota /api/review (servidor Next real + Supabase e IA simulados).
// Uso: NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 NEXT_PUBLIC_SUPABASE_ANON_KEY=x npx next build &&
//      REVIEW_AI_DEADLINE_MS=2500 ANTHROPIC_API_KEY=teste ANTHROPIC_BASE_URL=http://127.0.0.1:54322 npx next start -p 3100 &
//      node tests/e2e-route.mjs
import assert from "node:assert/strict";
import { anthropicRequests, start, USERS } from "./mock-server.mjs";

const BASE = process.env.BASE ?? "http://127.0.0.1:3100";
const P = (n) => `aaaaaaaa-0000-4000-8000-00000000000${n}`;
const mocks = await start();
let passed = 0;
async function post(body, token = "token-yasmim", raw) {
  const res = await fetch(`${BASE}/api/review`, { method: "POST", headers: { "content-type": "application/json", ...(token ? { authorization: `Bearer ${token}` } : {}) }, body: raw ?? JSON.stringify(body) });
  const type = res.headers.get("content-type") ?? "";
  const text = await res.text();
  assert.ok(type.includes("application/json"), `resposta não é JSON (${res.status}, ${type}): ${text.slice(0, 80)}`); // o bug original
  return { status: res.status, body: JSON.parse(text) };
}
async function t(name, fn) {
  try { await fn(); passed++; console.log(`ok   ${name}`); } catch (e) { console.log(`FAIL ${name}\n     ${e.message}`); process.exitCode = 1; }
}
const lastCalls = (from) => anthropicRequests.slice(from);

await t("20 questões: gera em 4 chamadas paralelas de 5 e devolve 20 cartões válidos com origem", async () => {
  const before = anthropicRequests.length;
  const { status, body } = await post({ action: "generate", pageIds: [P(1)], kind: "question", count: 20 });
  assert.equal(status, 200);
  assert.equal(body.cards.length, 20);
  assert.equal(lastCalls(before).length, 4);
  assert.ok(body.cards.every((c) => c.type === "question" && c.options.length === 5 && Number.isInteger(c.correctIndex) && c.explanation && c.topic));
  assert.deepEqual(body.sources.pageIds, [P(1)]);
  assert.equal(body.pageId, P(1));
  assert.equal(body.sources.pdfs.length, 1); // PDF anexado na página da própria usuária
  const doc = lastCalls(before)[0].messages[0].content.find((b) => b.type === "document");
  assert.ok(doc, "PDF não foi enviado à IA");
  assert.ok(new Set(body.cards.map((c) => c.topic)).size <= 2, "assuntos não foram unificados");
});
await t("10 questões e 5 flashcards (1 chamada)", async () => {
  const q = await post({ action: "generate", pageIds: [P(1)], kind: "question", count: 10 });
  assert.equal(q.body.cards.length, 10);
  const before = anthropicRequests.length;
  const f = await post({ action: "generate", pageIds: [P(1)], kind: "flashcard", count: 5 });
  assert.equal(f.status, 200);
  assert.equal(f.body.cards.length, 5);
  assert.ok(f.body.cards.every((c) => c.type === "flashcard" && c.answer));
  assert.equal(lastCalls(before).length, 1);
});
await t("JSON cortado pela IA (max_tokens) é recuperado: usa os itens completos em vez de quebrar", async () => {
  const { status, body } = await post({ action: "generate", pageIds: [P(5)], kind: "question", count: 5 });
  assert.equal(status, 200);
  assert.ok(body.cards.length >= 1 && body.cards.length < 5, `veio ${body.cards.length}`);
});
await t("IA lenta demais: responde 504 em JSON ANTES do limite da plataforma", async () => {
  const started = Date.now();
  const { status, body } = await post({ action: "generate", pageIds: [P(2)], kind: "question", count: 5 });
  assert.equal(status, 504);
  assert.match(body.error, /demorou/);
  assert.ok(body.ref);
  assert.ok(Date.now() - started < 4000);
});
await t("provedor devolve HTML 500, 429 e 401: mensagens claras, sem vazar detalhes", async () => {
  const a = await post({ action: "generate", pageIds: [P(3)], kind: "question", count: 5 });
  assert.equal(a.status, 502); assert.match(a.body.error, /IA/); assert.ok(!/<html|An error occurred/.test(JSON.stringify(a.body)));
  const b = await post({ action: "generate", pageIds: [P(4)], kind: "question", count: 5 });
  assert.equal(b.status, 429); assert.match(b.body.error, /pedidos demais/);
  const c = await post({ action: "generate", pageIds: [P(6)], kind: "question", count: 5 });
  assert.equal(c.status, 503); assert.match(c.body.error, /ANTHROPIC_API_KEY/);
  assert.ok(!JSON.stringify(c.body).includes("x-api-key"));
});
await t("validações: sem login, token inválido, corpo inválido, ação inválida, página vazia, sem material", async () => {
  assert.equal((await post({}, null)).status, 401);
  assert.equal((await post({ action: "generate", pageIds: [P(1)] }, "token-falso")).status, 401);
  assert.equal((await post(null, "token-yasmim", "isto não é json")).status, 400);
  assert.equal((await post({ action: "xyz" })).status, 400);
  assert.equal((await post({ action: "generate", pageIds: [P(7)] })).status, 400); // vazia
  assert.equal((await post({ action: "generate", pageIds: [] })).status, 400);
});
await t("isolamento: páginas e PDFs de outra usuária nunca chegam à IA", async () => {
  const before = anthropicRequests.length;
  const r = await post({ action: "generate", pageIds: [P(9)], kind: "question", count: 5 }); // página da OUTRA usuária
  assert.equal(r.status, 400);
  assert.equal(lastCalls(before).length, 0);
  const r2 = await post({ action: "generate", pageIds: [P(8)], pdfs: [{ url: `http://127.0.0.1:54321/storage/v1/object/public/files/${USERS["token-outra"]}/x.pdf`, name: "x.pdf" }], kind: "question", count: 5 });
  assert.equal(r2.status, 200);
  const sent = JSON.stringify(lastCalls(before));
  assert.ok(!sent.includes(USERS["token-outra"]), "PDF de outra usuária foi enviado");
  assert.ok(!sent.includes("SEGREDO"));
  assert.equal(r2.body.sources.pdfs.length, 0);
});

const answers = [
  { cardId: "cccccccc-0000-4000-8000-000000000001", question: "Qual enzima metaboliza o paracetamol?", topic: "Metabolismo hepático", concept: "Glucuronidação e CYP2E1", correct: false },
  { cardId: null, question: "Definição de biodisponibilidade?", topic: "Farmacocinética", concept: "Fração que chega à circulação", correct: false },
  { cardId: null, question: "Meia-vida é...", topic: "Farmacocinética", concept: null, correct: true },
  { cardId: null, question: "Via de excreção principal?", topic: "Farmacocinética", concept: null, correct: true },
  { cardId: null, question: "Agonista parcial é...", topic: "Farmacodinâmica", concept: null, correct: true },
  { cardId: null, question: "Antagonista competitivo...", topic: "Farmacodinâmica", concept: null, correct: true },
];
await t("revisão direcionada: só assuntos fracos, nível pedido, não repete perguntas, material original consultado", async () => {
  const before = anthropicRequests.length;
  const { status, body } = await post({ action: "focus", kind: "question", count: 10, difficulty: 2, title: "Farmacologia geral", answers, sources: { pageIds: [P(1)], pdfs: [] } });
  assert.equal(status, 200);
  assert.equal(body.cards.length, 10);
  assert.deepEqual([...body.focusTopics].sort(), ["Farmacocinética", "Metabolismo hepático"]);
  assert.equal(body.difficulty, 2);
  assert.ok(body.cards.every((c) => body.focusTopics.includes(c.topic)), "item fora dos pontos fracos");
  const prompt = JSON.stringify(lastCalls(before)[0].messages[0].content);
  assert.ok(prompt.includes("ASSUNTOS FRACOS") && prompt.includes("Metabolismo hepático") && prompt.includes("Glucuronidação"));
  assert.ok(prompt.includes("Qual enzima metaboliza o paracetamol?"), "perguntas anteriores não foram passadas para evitar repetição");
  assert.ok(prompt.includes("Nível 2"));
  assert.ok(!prompt.includes("Farmacodinâmica ("), "assunto sem erro não deveria ser foco"); // acertou tudo
  assert.ok(prompt.includes("paracetamol é metabolizado no fígado"), "material original não foi consultado");
  assert.ok(lastCalls(before)[0].messages[0].content.some((b) => b.type === "document"), "PDF original não foi reenviado");
  assert.ok(lastCalls(before).length === 2);
  const texts = body.cards.map((c) => c.question);
  assert.ok(!texts.some((q) => answers.some((a) => a.question === q)));
});
await t("revisão direcionada em flashcards e nível 3", async () => {
  const { status, body } = await post({ action: "focus", kind: "flashcard", count: 5, difficulty: 3, title: "t", answers, sources: { pageIds: [P(1)], pdfs: [] } });
  assert.equal(status, 200); assert.equal(body.cards.length, 5); assert.ok(body.cards.every((c) => c.type === "flashcard")); assert.equal(body.difficulty, 3);
});
await t("revisão direcionada recupera o material pelas páginas dos cartões quando a atividade não guardou a origem", async () => {
  const { status, body } = await post({ action: "focus", kind: "question", count: 5, difficulty: 1, title: "t", answers, sources: {} });
  assert.equal(status, 200); assert.deepEqual(body.sources.pageIds, [P(1)]);
});
await t("revisão direcionada sem origem recuperável, sem erros ou com dados inválidos: recusa com mensagem clara", async () => {
  const noOrigin = answers.map((a) => ({ ...a, cardId: null }));
  const a = await post({ action: "focus", kind: "question", count: 5, difficulty: 1, answers: noOrigin, sources: {} });
  assert.equal(a.status, 422); assert.match(a.body.error, /material original/);
  const b = await post({ action: "focus", kind: "question", count: 5, difficulty: 1, answers: answers.map((x) => ({ ...x, correct: true })), sources: { pageIds: [P(1)] } });
  assert.equal(b.status, 422); assert.match(b.body.error, /pontos fracos/);
  const c = await post({ action: "focus", kind: "question", count: 5, difficulty: 1, answers: "lixo", sources: { pageIds: [P(1)] } });
  assert.equal(c.status, 422);
});
await t("revisão direcionada não lê o material de outra usuária mesmo se o id for enviado", async () => {
  const r = await post({ action: "focus", kind: "question", count: 5, difficulty: 1, answers, sources: { pageIds: [P(9)] } }, "token-yasmim");
  assert.equal(r.status, 422);
});
await t("plano de revisão continua funcionando", async () => {
  const { status, body } = await post({ action: "plan", mode: "quiz", title: "t", topics: [{ topic: "Metabolismo hepático", correct: 0, total: 1 }], mistakes: [] });
  assert.equal(status, 200); assert.equal(body.plan.priorities[0].topic, "Metabolismo hepático");
});

console.log(`\n${passed} verificações passaram${process.exitCode ? ", com falhas" : ""}`);
mocks.close();
process.exit(process.exitCode ?? 0);
